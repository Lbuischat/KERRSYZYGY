
/* ==========================================
   EDITAR PERFIL E CONFIRMAR PERSONAGEM
========================================== */

.profile-edit-button,
.confirm-character-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 42px;
  padding: 11px 18px;
  border: 1px solid rgba(166, 170, 255, 0.3);
  background: rgba(113, 108, 184, 0.08);
  color: #e5e4ff;
  font: inherit;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.07em;
  cursor: pointer;
  transition: background 160ms, border-color 160ms;
}

.profile-edit-button:hover,
.confirm-character-button:hover {
  border-color: rgba(186, 190, 255, 0.75);
  background: rgba(128, 118, 225, 0.18);
}

.profile-edit-input {
  width: 100%;
  min-width: 0;
  margin-top: 10px;
  padding: 10px 12px;
  border: 1px solid rgba(170, 175, 220, 0.28);
  border-radius: 4px;
  background: #111520;
  color: #f0efff;
  font: inherit;
  font-size: 13px;
  color-scheme: dark;
}

.profile-edit-input:focus {
  outline: 1px solid #a9a1ff;
  border-color: #a9a1ff;
}

.profile-inline-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
}

.profile-counter {
  display: block;
  margin-top: 8px;
  color: #898ba1;
  font-size: 10px;
  text-align: right;
}

.profile-character-description {
  margin-top: 10px;
  color: rgba(255, 255, 255, 0.65);
}

.confirm-character-button {
  border-color: rgba(166, 157, 255, 0.65);
  background: linear-gradient(110deg, #3d3579, #6252bc);
  color: #fff;
}

@media (max-width: 650px) {
  .section-heading {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .profile-inline-actions {
    justify-content: stretch;
  }

  .profile-inline-actions button {
    flex: 1;
  }

  .confirm-character-button {
    width: 100%;
  }
}
